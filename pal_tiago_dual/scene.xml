<mujoco model="scene_test">
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Añadido desde screw.xml -->
    <texture name="tex_capa" type="2d" file="cup_pattern.png"/>
    <material name="mat_capa" texture="tex_capa" texrepeat="1 1"/>
  </asset>
  <include file="screw.xml"/>
  <default>
        <geom contype="1" conaffinity="1"
              friction="1.0 0.005 0.0001"
              solimp="0.95 0.99 0.001"
              solref="0.01 1"/>
        <joint damping="0.05"/>
    </default>

  <statistic center="0.7 0 0.8" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Añadido desde screw.xml -->
    <texture name="tex_capa" type="2d" file="cup_pattern.png"/>
    <material name="mat_capa" texture="tex_capa" texrepeat="1 1"/>
  </asset>


  <worldbody>
    <light pos="0 0 1.8" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <camera name="front_cam" pos="1.6 0 1.0" quat="0.9239 0 0.3827 0" fovy="50"/>

  </worldbody>

 

  <actuator>
    <motor name="motor_x" joint="cap_x" gear="10"/>
    <motor name="motor_xa" joint="cap_xa" gear="2"/>
    <motor name="motor_y" joint="cap_y" gear="10"/>
    <motor name="motor_ya" joint="cap_ya" gear="2"/>
    <motor name="motor_z" joint="cap_slide" gear="10"/>
    <motor name="motor_hinge" joint="cap_hinge" gear="2"/>
  </actuator>

</mujoco>

