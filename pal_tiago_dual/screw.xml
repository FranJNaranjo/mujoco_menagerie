<mujoco model="bottle_threaded_hinge_viz">

    


    <!-- Botella fija -->
    <body name="bottle" pos="0 0 0.1">
        <geom name="bottle_geom"
              type="cylinder"
              size="0.035 0.10"
              rgba="0.6 0.6 0.6 1"/>
        <!-- Tapa -->
        <body name="cap_root" pos="0 0 0.15">
            <inertial pos="0 0 0" mass="0.01" diaginertia="0.001 0.001 0.001"/>
            <joint name="cap_x" type="slide" axis="1 0 0" limited="false" damping="0.5"/>
            <joint name="cap_xa" type="hinge" axis="1 0 0" limited="false" damping="0.5"/>
            <joint name="cap_y" type="slide" axis="0 1 0" limited="false" damping="0.5"/>                
            <joint name="cap_ya" type="hinge" axis="0 1 0" limited="false" damping="0.5"/>
            <body name="cap_threaded">
                <joint name="cap_slide" type="slide" axis="0 0 1" range="-0.01 0.5" damping="0.1"/>
                <joint name="cap_hinge" type="hinge" axis="0 0 1" damping="0.2"/>
                <geom name="cap_geom" type="cylinder" size="0.04 0.025" material="mat_capa"/>
            </body>
        </body>
    </body>

    <!-- Luz -->
    <light pos="1 1 1.5" dir="-0.5 -0.5 -1.5" diffuse="1 1 1" specular="0.2 0.2 0.2"/>

    <!-- Cámara -->
    <camera name="maincam" pos="0.5 -0.7 0.3" xyaxes="1 0 0 0 1 0"/>

